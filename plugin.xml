<?xml version='1.0' encoding='utf-8'?>
<plugin id="cordova-plugin-ethernet-validator" version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>EthernetValidator</name>
    <js-module name="EthernetValidator" src="www/EthernetValidator.js">
        <clobbers target="cordova.plugins.EthernetValidator" />
    </js-module>
    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="EthernetValidator">
                <param name="android-package" value="com.probotisop.plugin.EthernetValidator" />
            </feature>
        </config-file>
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>
        <source-file src="src/android/EthernetValidator.java" target-dir="src/com/probotisop/plugin" />
    </platform>
</plugin>
